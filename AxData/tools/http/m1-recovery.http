@baseUrl = http://localhost:5116

# Before running these requests:
# 1. Start the API in PowerShell after setting:
#    $env:ASPNETCORE_ENVIRONMENT = "Development"
#    $env:AxData__M1__Enabled = "true"
#    $env:AxData__Redis__ConnectionString = "localhost:6385"
#    dotnet run --no-restore --project src/AxData.Api

### Init
# @name init
POST {{baseUrl}}/api/v1/axdata/init
Content-Type: application/json

{
  "transId": "sample-order",
  "key": null
}

### Set: creates a line and calculates amount = qty x rate
@objectId = {{init.response.body.$.objectId}}
POST {{baseUrl}}/api/v1/axdata/set
Content-Type: application/json

{
  "objectId": "{{objectId}}",
  "getDeps": true,
  "data": {
    "lines": {
      "rows": [
        {
          "rowId": "tmp:1",
          "action": "n",
          "fields": {
            "item": "widget",
            "rate": 12.5,
            "qty": 2
          }
        }
      ]
    }
  }
}

### Get from Redis; expect amount 25.0 and no object-version field
POST {{baseUrl}}/api/v1/axdata/get
Content-Type: application/json

{
  "objectId": "{{objectId}}"
}

# Evict only this active-state key in Memurai CLI. Replace OBJECT_ID with the Init response value in uppercase:
# memurai-cli -p 6385 DEL "AXD:{SAMPLE-TENANT}:OBJECT_ID"

### Get after eviction; expect 404 / AXD-NOTFOUND-001 with no database recovery attempt
POST {{baseUrl}}/api/v1/axdata/get
Content-Type: application/json

{
  "objectId": "{{objectId}}"
}

